IMAGE_FILE  "shelldb\\pre_ship\\sb_ua_d.pcx"			; 7
IMAGE_FILE  "shelldb\\pre_ship\\sb_ua_h.pcx"			; 8
IMAGE_FILE  "shelldb\\pre_ship\\sb_ua_s.pcx"			; 9

