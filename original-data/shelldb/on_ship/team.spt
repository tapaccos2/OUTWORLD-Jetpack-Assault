IMAGE_FILE	"shelldb\\common\\button_h.pcx"				; 10
IMAGE_FILE  "shelldb\\common\\button_f.pcx"				; 11

IMAGE_FILE  "shelldb\\on_ship\\slotarw.pcx"				; 12


BACKGROUND	"shelldb\\on_ship\\team.pcx"

CONTROLS 	mouse, keyboard

;--------------------------------------------------------------------
; main buttons for moving between teammate-armor-weapons screens
;--------------------------------------------------------------------

; generic message
LABEL 0 
	LOCATION 100 460
	END

; goto team - just to be consistant, we're already here
TOGGLE 3
	GROUP 1
	PICTURE #3, #1, #3, #5
	SELECTED #3, #3, #3, #3
	FOCUS_PICTURE #6 204 273

	LOCATION 204 241
	HOTSPOT 47 281, 225 281, 225 241, 23 234
	NEXT 100
	PREV 301
	ABOVE 2
	BELOW 1
	END

TOGGLE 1  ; goto weapons
	GROUP 1
	PICTURE #0, #1, #4, #5
	SELECTED #4, #4, #4, #4
	FOCUS_PICTURE #6 204 110

	LOCATION 204 78
	HOTSPOT 22 167, 225 156, 225 37, 47 37
	NEXT 100 
	PREV 301
	ABOVE 3
	BELOW 2
	END

; goto armor
TOGGLE 2
	GROUP 1
	PICTURE #0, #1, #2, #5
	SELECTED #2, #2, #2, #2
	FOCUS_PICTURE #6 204 210

	LOCATION 204 178
	HOTSPOT 71 224, 225 228, 225 169, 71 173
	NEXT 100
	PREV 301
	ABOVE 1
	BELOW 3
	END

; switch
BUTTON 4
	LOCATION 16 176
	HOTSPOTRECT 16 176 50 50
	END
		 
; current weapons load
LABEL 10
	LOCATION 52 67
	END
	
; current assigned armor
LABEL 11
	LOCATION 88 194
	END
	
; current teammate
LABEL 12
	LOCATION 57 262
	END

