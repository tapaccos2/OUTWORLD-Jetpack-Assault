CONTROLS 	mouse, keyboard

; message 
LABEL 1
	LOCATION 100 460
	END

; ok button
BUTTON 100
	PICTURE #0, #1, #2, #3
	FOCUS_PICTURE #4 279 154

	LOCATION 202 154
	HOTSPOTRECT 195 116 124 52
	NEXT 610
	PREV 101
	ABOVE 101
	BELOW 101
	END

; save button
BUTTON 101
	PICTURE #0, #1, #2, #3
	FOCUS_PICTURE #4 279 93

	LOCATION 202 93
	HOTSPOTRECT 195 55 124 52
	NEXT 100
	PREV 612
	ABOVE 100
	BELOW 100
	END

; replay movie - hidden
BUTTON 15
	LOCATION  78 42
	HOTSPOTRECT 78 42 94 118
	INVISIBLE
	END

; overview text
LISTBOX 610
	LOCATION 55 185
	DIMENSIONS  216 253 
	HOTSPOTRECT 55 185 216 253
	TEXT_COLOR        255 255 255
	SCROLLBAR 610
		LOCATION	 283 211
		DIMENSIONS   22  157
		BORDER_SIZE   0
