; assign weapons script
;
; we may need to make a seperate file for each armor suit type
;

IMAGE_FILE  "shelldb\\on_ship\\pan_n.pcx"				; 0
IMAGE_FILE  "shelldb\\on_ship\\pan_d.pcx"				; 1
IMAGE_FILE  "shelldb\\on_ship\\pan_sy.pcx"				; 2
IMAGE_FILE  "shelldb\\on_ship\\pan_sg.pcx"				; 3
IMAGE_FILE  "shelldb\\on_ship\\pan_sr.pcx"				; 4
IMAGE_FILE  "shelldb\\on_ship\\pan_h.pcx"				; 5
IMAGE_FILE  "shelldb\\on_ship\\pan_f.pcx"				; 6

IMAGE_FILE  "shelldb\\common\\button_n.pcx"				; 7
IMAGE_FILE  "shelldb\\common\\button_d.pcx"				; 8
IMAGE_FILE	"shelldb\\common\\button_p.pcx"				; 9
IMAGE_FILE	"shelldb\\common\\button_h.pcx"				; 10
IMAGE_FILE  "shelldb\\common\\button_f.pcx"				; 11


BACKGROUND	"shelldb\\on_ship\\weapons.pcx"

CONTROLS 	mouse, keyboard

;--------------------------------------------------------------------
; main buttons for moving between teammate-armor-weapons screens
;--------------------------------------------------------------------

; goto weapons - just to be consistant, we're already here
TOGGLE 1
	GROUP 1
	PICTURE #4, ;normal
			#1, ;disabled
			#4, ;selected
			#5	;highlight

	SELECTED #4, #4, #4, #4
	FOCUS_PICTURE #6 204 110

	LOCATION 204 78
	HOTSPOT 22 167, 225 156, 225 37, 47 37
	NEXT 104
	PREV 301
	ABOVE 3
	BELOW 2
	END

; goto armor
TOGGLE 2
	GROUP 1
	PICTURE #0, #1, #2, #5
	SELECTED #2, #2, #2, #2
	FOCUS_PICTURE #6 204 210

	LOCATION 204 178
	HOTSPOT 71 224, 225 228, 225 169, 71 173
	NEXT 104
	PREV 301
	ABOVE 1
	BELOW 3
	END

; goto team
TOGGLE 3
	GROUP 1
	PICTURE #0, #1, #3, #5
	SELECTED #3, #3, #3, #3
	FOCUS_PICTURE #6 204 273

	LOCATION 204 241
	HOTSPOT 47 281, 225 281, 225 241, 23 234
	NEXT 104
	PREV 301
	ABOVE 2
	BELOW 1
	END

; switch
BUTTON 4
	LOCATION 16 176
	HOTSPOTRECT 16 176 50 50
	END

; current weapons load
LABEL 10
	LOCATION 52 67
	END
LABEL 11
	LOCATION 52 77
	END
LABEL 12
	LOCATION 52 87
	END
LABEL 13
	LOCATION 52 97
	END
LABEL 14
	LOCATION 52 107
	END
	
; current assigned armor
LABEL 15
	LOCATION 88 194
	END
	
; current teammate
LABEL 16
	LOCATION 57 262
	END

