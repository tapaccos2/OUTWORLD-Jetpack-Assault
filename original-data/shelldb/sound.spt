; qsound3d/stereo
TOGGLE 10
	PICTURE		#24, #25, #26, #27
	SELECTED	#28, #29, #30, #31
	LOCATION    232 18
;	DIMENSIONS	26  16
	HOTSPOTRECT	232 18 26 16
	GROUP	 1
	ABOVE 11
	BELOW 11
	LEFT  20
	RIGHT 20
	NEXT 100
	PREV 300
	END

; qsound3d/stereo
